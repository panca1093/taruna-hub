# Cloudflare terminates public TLS; this origin presents a Cloudflare Origin Certificate (Full strict).
# Authenticated Origin Pulls uses a client cert shared by all Cloudflare customers, so it only blocks
# requests that bypass Cloudflare and hit the VPS IP directly, not other Cloudflare zones.
{
	auto_https off
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloudflare-origin-pull-ca.pem
		}
	}
}

{$DOMAIN}:443 {
	import origin_tls
	encode zstd gzip
	request_body {
		max_size 100MB
	}
	handle /api/* {
		reverse_proxy api:8081
	}
	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN}:443 {
	import origin_tls
	redir https://{$DOMAIN}{uri} permanent
}

# Presigned links sign the Host header, which reverse_proxy passes through unchanged.
files.{$DOMAIN}:443 {
	import origin_tls
	request_body {
		max_size 100MB
	}
	reverse_proxy rustfs:9000
}
