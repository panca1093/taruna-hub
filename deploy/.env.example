# Copy to /opt/taruna/.env on the VPS (chmod 600). Compose reads it for ${...} substitution, and the API
# and worker load it as their environment. JWT_SECRET and NOTIFICATION_SEAL_KEY: openssl rand -base64 32.
# Passwords end up inside URLs, so generate them as hex instead: openssl rand -hex 24
DOMAIN=tarunaedu.com
TENANT_SLUG=taruna

POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=taruna
STORAGE_SECRET_KEY=

JWT_SECRET=
NOTIFICATION_SEAL_KEY=

# Manual bank transfer; unset, manual checkout answers 503.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

# Midtrans; unset, the gateway method is not offered. Notification URL: https://tarunaedu.com/api/v1/payments/midtrans/notification
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Email; unset, signup codes and password resets are unavailable.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@tarunaedu.com

# Off-site backups (deploy/backup.sh) to a Cloudflare R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taruna-backup
