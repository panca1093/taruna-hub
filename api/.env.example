APP_ENV=development
PORT=8081
DATABASE_URL=postgres://tryout:tryout@localhost:5433/tryout?sslmode=disable
# Auth throttles. Required outside development; development defaults to the compose port below.
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3000
# Required outside development; tenants live at <slug>.<BASE_DOMAIN>.
# BASE_DOMAIN=tarunaeduka.id
# Only behind a proxy that strips the client X-Forwarded-Host.
# TRUST_FORWARDED_HOST=false
# Email delivery (P02). An unset SMTP_HOST is legal everywhere: email is then UNAVAILABLE.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@tarunaeduka.id
# SMTP_TLS is starttls (default), tls, or none. none is only allowed when APP_ENV=development, and
# SMTP_USERNAME over none is only allowed against a loopback SMTP_HOST (localhost, 127.0.0.1, ::1).
# SMTP_TLS=starttls
# Base64 of exactly 32 bytes. REQUIRED in every environment: signup codes and reset links are sealed
# with it. Replacing it invalidates every sealed message that has not been delivered yet.
# Generate one with: openssl rand -base64 32
NOTIFICATION_SEAL_KEY=
# Links in emails go to <scheme>://<slug>.<BASE_DOMAIN>[:port]. Defaults: http and 3000 in
# development; https and no port elsewhere, where http is refused.
# PUBLIC_WEB_SCHEME=https
# PUBLIC_WEB_PORT=
# Signs access tokens; REQUIRED in every environment and must decode to at least 32 bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
# Object storage for uploads (P06): MinIO locally, GCS (HMAC keys) in production. An unset S3_ENDPOINT
# is legal everywhere: the asset routes then answer 503. The bucket stays private; development creates
# it on startup, every other environment requires it to exist.
S3_ENDPOINT=localhost:9002
S3_ACCESS_KEY=tryout
S3_SECRET_KEY=tryout123
S3_BUCKET=tryout-assets
S3_USE_SSL=false
# S3_REGION=
