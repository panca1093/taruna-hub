APP_ENV=development
PORT=8081
DATABASE_URL=postgres://tryout:tryout@localhost:5433/tryout?sslmode=disable
CORS_ORIGINS=http://localhost:3000
# Required outside development; tenants live at <slug>.<BASE_DOMAIN>.
# BASE_DOMAIN=tarunaeduka.id
# Only behind a proxy that strips the client X-Forwarded-Host.
# TRUST_FORWARDED_HOST=false
# Email delivery (P02). An unset SMTP_HOST is legal everywhere: email is then UNAVAILABLE.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@tarunaeduka.id
# SMTP_TLS is starttls (default), tls, or none. none is only allowed when APP_ENV=development, and
# SMTP_USERNAME over none is only allowed against a loopback SMTP_HOST (localhost, 127.0.0.1, ::1).
# SMTP_TLS=starttls
# Base64 of exactly 32 bytes. Required to enqueue notifications that carry a secret; replacing it
# invalidates every sealed message that has not been delivered yet.
# NOTIFICATION_SEAL_KEY=
